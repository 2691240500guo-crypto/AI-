pipeline {
    agent any

    stages {

        stage('拉取代码检查') {
            steps {
                echo '开始执行 AI-talent CI/CD'
                sh 'pwd'
                sh 'ls -la'
            }
        }

        stage('测试成功') {
            steps {
                echo 'Jenkins 已经成功从 GitHub 拉取项目代码！'
            }
        }
    }
}
