# Copy to .env and fill deployment-specific values. Never commit the real .env.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/health_assessment?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
SILICONFLOW_API_KEY=
JWT_SECRET=generate-a-long-random-secret
JWT_EXPIRE_MINUTES=720
# Required in production; 32 random bytes encoded as base64 or another high-entropy secret.
HEALTH_DATA_ENCRYPTION_KEY=
TONGUE_YOLO_MODEL=models/tongue/yolov8n-tongue.pt
TONGUE_CLASSIFIER_MODEL=models/tongue/tongue_classifier.pt
